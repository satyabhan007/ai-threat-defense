# Multi-stage static build for Go Security Gateway (<15MB distroless)
FROM golang:1.22-alpine AS builder

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true

COPY ch05_golang_gateway/ ./ch05_golang_gateway/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -extldflags '-static'" \
    -o /bin/threat-gateway ./ch05_golang_gateway/cmd/gateway

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /
COPY --from=builder /bin/threat-gateway /threat-gateway

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/threat-gateway"]
CMD ["-port", "8080", "-upstream", "http://model-service:8000"]
